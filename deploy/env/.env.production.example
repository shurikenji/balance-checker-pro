PORT=3000
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-session-secret
DB_PATH=/var/lib/balance-checker-pro/app.db
SESSION_DB_PATH=/var/lib/balance-checker-pro/app.db
SESSION_CLEANUP_INTERVAL_MS=900000
ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
WORKER_ENABLED=true
WORKER_POLL_MS=3000
ADMIN_IP_ALLOWLIST=
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
