<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at top left, rgba(22, 92, 211, 0.14), transparent 28%),
          radial-gradient(circle at bottom right, rgba(31, 122, 90, 0.14), transparent 22%),
          #f4f7fb;
        font-family: Georgia, "Times New Roman", serif;
        color: #16202a;
      }

      .wrap {
        width: min(920px, calc(100vw - 32px));
        margin: 48px auto;
      }

      .hero,
      .panel,
      .result,
      .error {
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(8px);
        border-radius: 22px;
        box-shadow: 0 18px 48px rgba(18, 31, 44, 0.1);
      }

      .hero {
        padding: 28px 30px;
        margin-bottom: 22px;
      }

      h1 {
        margin: 0 0 12px;
        font-size: clamp(2rem, 4vw, 3.2rem);
        line-height: 1;
      }

      .sub {
        max-width: 720px;
        color: #4f6274;
        line-height: 1.6;
        margin: 0;
      }

      .panel {
        padding: 28px 30px;
      }

      .helper {
        margin: 0 0 18px;
        color: #5f7182;
        line-height: 1.6;
      }

      form {
        display: grid;
        gap: 18px;
      }

      label {
        display: block;
        margin-bottom: 8px;
        font-weight: 700;
        font-size: 0.95rem;
      }

      input,
      select {
        width: 100%;
        padding: 14px 16px;
        border-radius: 14px;
        border: 1px solid #cdd9e5;
        box-sizing: border-box;
        font: inherit;
        background: #fff;
      }

      button {
        width: fit-content;
        min-width: 180px;
        padding: 14px 18px;
        border: 0;
        border-radius: 14px;
        background: #165cd3;
        color: #fff;
        font-weight: 700;
        cursor: pointer;
      }

      button[disabled] {
        opacity: 0.72;
        cursor: wait;
      }

      .loading {
        margin-top: 18px;
        color: #415364;
        display: none;
      }

      .error {
        margin-top: 18px;
        padding: 16px 18px;
        color: #a11d1d;
        display: none;
      }

      .result {
        margin-top: 22px;
        padding: 24px 26px;
        display: none;
      }

      .result-head {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: baseline;
        flex-wrap: wrap;
      }

      .badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 999px;
        background: #e9f8ef;
        color: #17663a;
        font-size: 0.85rem;
        font-weight: 700;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-top: 20px;
      }

      .stat {
        padding: 18px;
        border-radius: 16px;
        background: #f8fafc;
      }

      .stat span {
        display: block;
        color: #5d6f80;
        margin-bottom: 8px;
      }

      .stat strong {
        font-size: 1.5rem;
      }

      .meta {
        margin-top: 0;
        color: #566879;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <section class="hero">
        <h1>Check API Balance</h1>
        <p class="sub">
          Choose the correct server first, then check a single API key. This public
          page does not auto-switch servers. Each request uses exactly the server
          ID you selected.
        </p>
      </section>

      <section class="panel">
        <p class="helper">
          This page submits to the JSON API directly. Select a server ID, enter the
          API key, and the result will be rendered without reloading the page.
        </p>

        <form id="check-form">
          <div>
            <label for="server_id">Server ID</label>
            <select id="server_id" name="server_id" required>
              <option value="">Select server</option>
              <% servers.forEach((server) => { %>
              <option value="<%= server.id %>">#<%= server.id %> - <%= server.name %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="api_key">API Key</label>
            <input
              id="api_key"
              name="api_key"
              type="password"
              placeholder="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
              autocomplete="off"
              required
            />
          </div>

          <button id="submit-button" type="submit">Check Balance</button>
        </form>

        <div id="loading" class="loading">Checking balance...</div>
        <div id="error-box" class="error"></div>

        <section id="result-box" class="result">
          <div class="result-head">
            <div>
              <h2 id="result-server-name" style="margin: 0 0 10px"></h2>
              <span class="badge">Request completed</span>
            </div>
            <div class="meta">Latency: <strong id="result-latency"></strong></div>
          </div>

          <div class="stats">
            <div class="stat">
              <span>Balance</span>
              <strong id="result-balance"></strong>
            </div>
            <div class="stat">
              <span>Usage</span>
              <strong id="result-usage"></strong>
            </div>
            <div class="stat">
              <span>Limit</span>
              <strong id="result-limit"></strong>
            </div>
          </div>
        </section>
      </section>
    </div>

    <script>
      const form = document.getElementById('check-form');
      const submitButton = document.getElementById('submit-button');
      const loadingBox = document.getElementById('loading');
      const errorBox = document.getElementById('error-box');
      const resultBox = document.getElementById('result-box');
      const resultServerName = document.getElementById('result-server-name');
      const resultLatency = document.getElementById('result-latency');
      const resultBalance = document.getElementById('result-balance');
      const resultUsage = document.getElementById('result-usage');
      const resultLimit = document.getElementById('result-limit');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const formData = new FormData(form);
        const serverId = String(formData.get('server_id') || '').trim();
        const apiKey = String(formData.get('api_key') || '').trim();

        hideError();
        hideResult();

        if (!serverId) {
          showError('Please choose a server ID');
          return;
        }

        if (!apiKey) {
          showError('Please enter an API key');
          return;
        }

        setLoading(true);

        try {
          const response = await fetch('/api/check', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              server_id: Number(serverId),
              api_key: apiKey,
            }),
          });

          const payload = await response.json();

          if (!response.ok || !payload.ok) {
            throw new Error((payload && payload.error && payload.error.message) || 'Failed to check balance');
          }

          resultServerName.textContent = `#${payload.server_id} - ${payload.server_name}`;
          resultLatency.textContent = `${payload.latency_ms} ms`;
          resultBalance.textContent = `$${payload.balance_usd}`;
          resultUsage.textContent = `$${payload.usage_usd}`;
          resultLimit.textContent = `$${payload.limit_usd}`;
          resultBox.style.display = 'block';
        } catch (error) {
          showError(error.message || 'Failed to check balance');
        } finally {
          setLoading(false);
        }
      });

      function setLoading(isLoading) {
        submitButton.disabled = isLoading;
        submitButton.textContent = isLoading ? 'Checking...' : 'Check Balance';
        loadingBox.style.display = isLoading ? 'block' : 'none';
      }

      function showError(message) {
        errorBox.textContent = message;
        errorBox.style.display = 'block';
      }

      function hideError() {
        errorBox.textContent = '';
        errorBox.style.display = 'none';
      }

      function hideResult() {
        resultBox.style.display = 'none';
      }
    </script>
  </body>
</html>
