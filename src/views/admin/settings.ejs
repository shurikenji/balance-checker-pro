<%- include('partials/layout') %>

      <% if (error || success) { %>
      <section class="messages">
        <% if (error) { %>
        <div class="message error">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          <%= error %>
        </div>
        <% } %>
        <% if (success) { %>
        <div class="message success">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <%= success %>
        </div>
        <% } %>
      </section>
      <% } %>

      <section class="card animate-fade-in">
        <div class="card-header">
          <h2 class="card-title">System Settings</h2>
        </div>
        <div class="card-body">
          <p class="meta" style="margin-bottom: 24px">
            These values are used directly by batch worker scheduling and request handling.
            Changes apply to future requests immediately.
          </p>

          <form method="post" action="/admin/settings">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

            <div style="display: grid; gap: 16px;">
              <% settings.forEach((setting) => { %>
              <div style="padding: 20px; background: var(--color-border-light); border-radius: var(--radius-lg);">
                <label for="<%= setting.key %>" style="font-size: 15px; margin-bottom: 6px; display: block;"><%= setting.label %></label>
                <p class="meta" style="margin-bottom: 12px;"><%= setting.description %></p>
                <input
                  id="<%= setting.key %>"
                  name="<%= setting.key %>"
                  type="<%= setting.inputType %>"
                  min="<%= setting.min %>"
                  step="<%= setting.step %>"
                  value="<%= setting.value %>"
                  required
                  style="max-width: 280px;"
                />
              </div>
              <% }) %>
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top: 24px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Save Settings
            </button>
          </form>
        </div>
      </section>
    </div>
  </main>
</div>
</body>
</html>
