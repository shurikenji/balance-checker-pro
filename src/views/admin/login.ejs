<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #eef2f7, #dde7f1);
        font-family: "Segoe UI", sans-serif;
        color: #18222c;
      }

      .card {
        width: min(420px, calc(100vw - 32px));
        padding: 32px;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 24px 60px rgba(24, 34, 44, 0.12);
      }

      h1 {
        margin: 0 0 10px;
      }

      p {
        margin: 0 0 24px;
        color: #5a6a79;
      }

      label {
        display: block;
        margin-bottom: 8px;
        font-size: 0.95rem;
        font-weight: 600;
      }

      input {
        width: 100%;
        padding: 12px 14px;
        margin-bottom: 18px;
        border: 1px solid #c9d5e2;
        border-radius: 10px;
        box-sizing: border-box;
      }

      button {
        width: 100%;
        padding: 12px 14px;
        border: 0;
        border-radius: 10px;
        background: #175cd3;
        color: #fff;
        font-weight: 700;
        cursor: pointer;
      }

      .error {
        margin-bottom: 16px;
        padding: 12px;
        border-radius: 10px;
        background: #fff0f0;
        color: #9a1c1c;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <h1>Admin Login</h1>
      <p>Sign in to manage proxies, jobs, and system settings.</p>

      <% if (error) { %>
      <div class="error"><%= error %></div>
      <% } %>

      <form method="post" action="/admin/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <label for="username">Username</label>
        <input id="username" name="username" type="text" autocomplete="username" required />

        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />

        <button type="submit">Login</button>
      </form>
    </main>
  </body>
  </html>
