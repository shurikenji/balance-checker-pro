<%- include('partials/layout') %>

      <% if (error || success) { %>
      <section class="messages">
        <% if (error) { %>
        <div class="message error">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          <%= error %>
        </div>
        <% } %>
        <% if (success) { %>
        <div class="message success">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <%= success %>
        </div>
        <% } %>
      </section>
      <% } %>

      <section class="card animate-fade-in">
        <div class="card-header">
          <h2 class="card-title">Create Batch Job</h2>
        </div>
        <div class="card-body">
          <p class="meta" style="margin-bottom: 20px">
            Paste keys into the text area with one key per line. File upload still works
            as a fallback for `.txt` and `.csv`, but direct paste is the primary flow.
            A specific proxy/server must be selected for every batch.
          </p>

          <form method="post" action="/admin/batches?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

            <div class="form-grid">
              <div class="form-group">
                <label for="proxy_id">Proxy selection</label>
                <select id="proxy_id" name="proxy_id" required>
                  <option value="">Select proxy/server</option>
                  <% proxies.forEach((proxy) => { %>
                  <option value="<%= proxy.id %>"><%= proxy.name %> (<%= proxy.status %>)</option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="form-group full" style="margin-top: 20px;">
              <label for="batch_keys">Batch keys</label>
              <textarea
                id="batch_keys"
                name="batch_keys"
                placeholder="sk-xxxxxxxxxxxxxxxxxxxxxxxx&#10;sk-yyyyyyyyyyyyyyyyyyyyyyyy&#10;sk-zzzzzzzzzzzzzzzzzzzzzzzz"
                rows="6"
              ></textarea>
            </div>

            <div class="form-group full" style="margin-top: 12px;">
              <label for="batch_file">Batch file</label>
              <input id="batch_file" name="batch_file" type="file" accept=".txt,.csv,text/plain,text/csv" />
              <div class="meta" style="margin-top: 8px">
                Optional if you already pasted keys above.
              </div>
            </div>

            <div style="margin-top: 20px;">
              <button type="submit" class="btn btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Create Batch
              </button>
            </div>
          </form>
        </div>
      </section>

      <section class="card animate-fade-in" style="margin-top: 24px;">
        <div class="card-header">
          <h2 class="card-title">Batch Jobs</h2>
        </div>
        <div class="card-body" style="padding: 0;">
          <p class="meta" style="padding: 20px 24px 0;">
            Jobs are queued and processed by the internal worker using the selected server.
          </p>

          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th>Job</th>
                  <th>Status</th>
                  <th>Progress</th>
                  <th>Preview</th>
                </tr>
              </thead>
              <tbody>
                <% if (!jobs.length) { %>
                <tr>
                  <td colspan="4">
                    <div class="empty-state">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                      <h3>No batch jobs yet</h3>
                      <p>Create your first batch job to get started</p>
                    </div>
                  </td>
                </tr>
                <% } %>

                <% jobs.forEach((job) => { %>
                <tr>
                  <td>
                    <strong>#<%= job.id %></strong>
                    <div class="meta">
                      requested proxy: <%= job.requested_proxy_name || 'missing' %><br />
                      created by: <%= job.created_by_username || 'system' %><br />
                      created at: <%= job.created_at %>
                    </div>
                  </td>
                  <td>
                    <span class="badge <%= job.status %>"><%= job.status %></span>
                  </td>
                  <td class="meta">
                    total: <%= job.total_items %><br />
                    processed: <%= job.processed_items %><br />
                    success: <%= job.success_items %><br />
                    failed: <%= job.failed_items %>
                  </td>
                  <td>
                    <div style="background: var(--color-border-light); padding: 12px; border-radius: var(--radius-md);">
                      <div class="meta" style="margin-bottom: 8px">First <%= job.itemsPreview.length %> items</div>
                      <ul style="margin: 0; padding-left: 20px; font-size: 13px;">
                        <% job.itemsPreview.forEach((item) => { %>
                        <li style="margin-bottom: 4px;">
                          line <%= item.line_number %> - <%= item.api_key_mask %> - <span class="badge <%= item.status %>" style="font-size: 11px; padding: 2px 8px;"><%= item.status %></span>
                        </li>
                        <% }) %>
                      </ul>
                      <a href="/admin/batches/<%= job.id %>" class="btn btn-outline btn-sm" style="margin-top: 12px; display: inline-flex;">
                        View details
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </a>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </main>
</div>
</body>
</html>
